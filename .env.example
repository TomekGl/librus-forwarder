# Login i hasło do konta Librus Synergia
LIBRUS_LOGIN=
LIBRUS_PASSWORD=

# Sekret ze ścieżki POST /fetch/<sekret> - długi losowy ciąg, np. `openssl rand -hex 32`
FETCH_SECRET=

# Lista celów powiadomień rozdzielona przecinkami. Na razie wspierany: stdout
NOTIFY_TARGETS=stdout

# Wymagany tylko gdy NOTIFY_TARGETS zawiera "slack"
# SLACK_WEBHOOK_URL=

# Port, na którym nasłuchuje serwer HTTP
PORT=8080

# Ścieżka pliku ze stanem (ostatnio przetworzona wiadomość)
STATE_FILE_PATH=/data/state.json

# ID folderu Librus: 5 = odebrane, 6 = wysłane
LIBRUS_INBOX_FOLDER_ID=5

# Poziom logowania: trace|debug|info|warn|error
LOG_LEVEL=info

# true -> czytelne logi w konsoli (dev), false/pominięte -> JSON (do archiwizacji w k8s)
LOG_PRETTY=true

# Timeout żądań do Librusa w ms
LIBRUS_REQUEST_TIMEOUT_MS=30000
